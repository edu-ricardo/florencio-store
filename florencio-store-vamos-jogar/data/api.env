# Preencha no Umbrel e reinicie o app. Arquivo em
# ~/umbrel/app-data/florencio-store-vamos-jogar/data/api.env — guarde uma cópia fora do Umbrel.
#
# Superusuário do PocketBase (mesmos valores do pocketbase.env)
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
LUDOPEDIA_ACCESS_TOKEN=
BGG_API_KEY=
# Notificações (Web Push). Gere uma vez com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Endereço público do app (também usado como contato das notificações)
FRONTEND_URL=https://vamosjogar.eduhomelab.monster
# Painel de admin: e-mails (separados por vírgula) que são sempre admins do app
APP_ADMIN_EMAILS=
