# Preencha no Umbrel e reinicie o app. Este arquivo fica em
# ~/umbrel/app-data/florencio-store-vamos-jogar/data/api.env — guarde uma cópia fora do Umbrel.
#
# Credencial do Firebase: copie o .json da conta de serviço para
# ~/umbrel/app-data/florencio-store-vamos-jogar/data/firebase-service-account.json
# (não precisa colar o JSON aqui).
LUDOPEDIA_ACCESS_TOKEN=
BGG_API_KEY=
CRON_SECRET=
RESEND_API_KEY=
# Endereço público do app (link dos e-mails de lembrete)
FRONTEND_URL=
