# Configuração do Postiz no Umbrel.
# Arquivo: /home/umbrel/umbrel/app-data/florencio-store-postiz/data/postiz.env
# Depois de editar, reinicie o app pelo Umbrel.

# ── Endereço do Postiz (obrigatório) ───────────────────────────────────────
# Use exatamente o endereço que você digita no navegador: o login só funciona
# por ele (por IP ou outro nome o cookie não vale e o login volta à tela inicial).
# Para conectar redes sociais, troque pelo domínio público com HTTPS
# (ex.: https://postiz.seudominio.com via DockFlare/Cloudflare Tunnel, apontando
# para florencio-store-postiz_web_1:5000) e apague a linha NOT_SECURED.
MAIN_URL=http://umbrel.local:8805
FRONTEND_URL=http://umbrel.local:8805
NEXT_PUBLIC_BACKEND_URL=http://umbrel.local:8805/api
# Necessário enquanto o endereço for http:// (sem HTTPS)
NOT_SECURED=true

# Depois de criar a sua conta, troque para true para ninguém mais se cadastrar
DISABLE_REGISTRATION=false

# ── Redes sociais (preencha só as que for usar) ────────────────────────────
# Cada rede exige criar um app no portal de desenvolvedor dela; a URL de retorno
# é <FRONTEND_URL>/integrations/social/<rede>. Guia: https://docs.postiz.com/providers
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
BEEHIIVE_API_KEY=
BEEHIIVE_PUBLICATION_ID=

# ── Opcional ───────────────────────────────────────────────────────────────
# Recursos de IA (geração de textos/imagens)
OPENAI_API_KEY=
