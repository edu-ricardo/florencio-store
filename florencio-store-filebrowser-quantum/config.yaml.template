# Configuração do FileBrowser Quantum no Umbrel.
# Este arquivo é gerado a partir de config.yaml.template a cada instalação e atualização
# do app: edições feitas em app-data/florencio-store-filebrowser-quantum/config.yaml
# são perdidas na próxima atualização. Para mudar algo de forma permanente, altere o
# config.yaml.template no repositório da loja.
# Documentação: https://filebrowserquantum.com/en/docs/
http:
  port: 80
  baseURL: "/"
  # Atrás do proxy do Umbrel: usa o endereço real do cliente nos cookies, links e logs
  trustProxyHeaders: true
server:
  logging:
    - levels: "info|error|warning"
      apiFilter: "disabled"
  sources:
    # Arquivos do Umbrel (o app Files): Downloads, Documents, etc.
    - path: "/srv"
      name: "Umbrel"
auth:
  # Usuário admin criado na primeira vez. A senha vem da variável
  # FILEBROWSER_ADMIN_PASSWORD (a senha que o Umbrel mostra ao abrir o app).
  # Na versão 2.0.0 esses campos ficam aqui, e não dentro de "methods.password".
  adminUsername: "admin"
  methods:
    password:
      enabled: true
      minLength: 8
      signup: false
    passkey:
      enabled: false
