# Configuração do Jellydash no Umbrel.
# Arquivo: /home/umbrel/umbrel/app-data/florencio-store-jellydash/data/jellydash.env
# Depois de editar, reinicie o app pelo Umbrel.

# ── Jellyfin (obrigatório) ─────────────────────────────────────────────────
# O endereço abaixo é o do app Jellyfin oficial do Umbrel. Se o seu Jellyfin
# roda em outro lugar, troque pela URL dele (ex.: http://192.168.0.10:8096).
JELLYFIN_URL=http://jellyfin_server_1:8096
# Crie a chave no Jellyfin: Painel > Chaves de API > "+" e cole aqui.
JELLYFIN_API_TOKEN=
JELLYFIN_VERIFY_SSL=true

# ── Jellyseerr / Seerr (opcional) ──────────────────────────────────────────
# JELLYSEER_URL=http://jellyseerr_server_1:5055
# JELLYSEER_API_TOKEN=

# ── Login próprio (opcional; o Umbrel já pede login na frente) ─────────────
# AUTH_ENABLED=true
# AUTH_ADMIN_USER=admin
# AUTH_ADMIN_PASSWORD=troque-esta-senha

# ── Notificações (opcional) ────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
# NTFY_URL=
# NTFY_TOPIC=
# APP_URL=http://umbrel.local:8795
